# LLM Configuration
# Set to 'true' to use local Ollama, 'false' to use the built-in simulator
USE_LOCAL_LLM=false

# Ollama Configuration (when USE_LOCAL_LLM=true)
OLLAMA_URL=http://localhost:11434
MODEL=llama3.2:3b

# Alternative: Cloud LLM APIs (not implemented in this demo)
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
